# Solana RPC URL (e.g. Mainnet, Devnet, or your preferred RPC provider)
NEXT_PUBLIC_RPC_URL="your_rpc_url"

# Program ID of your deployed ICO contract
NEXT_PUBLIC_PROGRAM_ID="your_deployed_ico_program_id"

# Token Mint address of your $RHFI token
NEXT_PUBLIC_TOKEN_MINT="your_token_mint_address"

# Admin wallet that has authority over the ICO
NEXT_PUBLIC_ADMIN_WALLET="your_admin_wallet_address"

# Receiver address where the SOL payments will be sent
NEXT_PUBLIC_RECEIVER_ADDRESS="your_receiver_wallet_address"

# Seeds for PDA derivation (these should match your contract)
NEXT_PUBLIC_ICO_PDA_SEED="ico_pda"
NEXT_PUBLIC_PROGRAM_ATA_SEED="program_ata"

# Presale Configuration
NEXT_PUBLIC_PRESALE_PRICE="0.00015"
NEXT_PUBLIC_LAUNCH_PRICE="0.0002"
NEXT_PUBLIC_PRESALE_END_DATE="2025-02-20T23:59:59Z" 